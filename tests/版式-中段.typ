//// 以下开始排正文

= 南辕北辙#super[\*]

// 题注
#notes[\* 本文选自《战国策》。题目为后人所加。]

// 每篇一个#ntp(注释、翻译、拼音集成版式)
#ntp[
  // 每句一个#snt（sentence），零碎句子可以合并到前后句中，也可以保持原样
  // # snt前加空行可形成分段
  #snt(notes: (
    // 这里是注释列表，按顺序与正文中的# nt一一匹配
    // 造成正文大空白的原因是加框文本中不允许断行，大空白过于严重时可把长文本拆开后注释
    // 注释过于密集时，译文中有清晰对应词语的，其注释可留空，同时再给译文中的对应词语加#nt标记
    [],
    [衣服皱缩而不展平],
    [头上沾满尘土而不洗濯],
  ))[
    // 这里是正文
    // #nt(ln:2, a:"l", o:0em) 注释默认参数：2行，left对齐，偏置0字宽（可用负数）
    // 为节省空间，磕巴ln调整为1
    // 注释重叠时可调整对齐和偏置
    魏王欲攻邯郸，季梁闻之，#nt[中道而反]，#nt(ln: 1)[衣焦不申]，#nt(ln: 1)[头尘不浴]，往见王曰：
  ][
    // 这里是译文，前后重叠时可适当精简文字
    魏王打算攻打邯郸，季梁听说后，立刻#nt[中途返回]，衣服皱缩也不展平，头上沾满尘土也不洗濯，急忙去见魏王说：
  ][
    // 拼音为临时占位，不需要处理
    wèi wáng yù gōng hán dān jì liáng wén zhī zhōng dào ér fǎn yī jiāo bù shēn tóu chén bú yù wǎng jiàn wáng yuē
  ]
  #snt(notes: (
    [大道],
    [面向北方],
    [前往楚国],
  ))[
    “今者臣来，见人于#nt[大行]，方#nt[北面]而持其驾，告臣曰：‘我欲#nt[之楚]。’
  ][
    “刚才我来的时候，在#nt[大道上]遇见一个人，正面向北方驾着车，告诉我说：‘我要去楚国。’
  ][
    jīn zhě chén lái jiàn rén yú dà háng fāng běi miàn ér chí qí jià gào chén yuē wǒ yù zhī chǔ
  ]
  #snt(notes: (
    [为何],
  ))[
    臣曰：‘君之楚，将#nt[奚为]北面？’
  ][
    我说：‘您要去楚国，为何却往北走？’
  ][
    chén yuē jūn zhī chǔ jiāng xī wéi běi miàn
  ]
  #snt[
    曰：‘吾马良。’
  ][
    他说：‘我的马很好。’
  ][
    yuē wú mǎ liáng
  ]
  #snt[
    臣曰：‘马虽良，此非楚之路也。’
  ][
    我说：‘马虽然好，但这不是去楚国的路啊。’
  ][
    chén yuē mǎ suī liáng cǐ fēi chǔ zhī lù yě
  ]
  #snt(note: (
    [路费、资财],
  ))[
    曰：‘吾#nt[用]多。’
  ][
    他又说：‘我的路费很充足。’
  ][
    yuē wú yòng duō
  ]
  #snt[
    臣曰：‘用虽多，此非楚之路也。’
  ][
    我说：‘路费虽然充足，但这不是去楚国的路啊。’
  ][
    chén yuē yòng suī duō cǐ fēi chǔ zhī lù yě
  ]
  #snt(notes: (
    [驾车的人],
  ))[
    曰：‘吾#nt[御者]善。’
  ][
    他又说：‘我的车夫技术高超。’
  ][
    yuē wú yù zhě shàn
  ]
  #snt[
    此数者愈善，而离楚愈远耳。”
  ][
    其实这几样条件越好，反而离楚国越远了。
  ][
    cǐ shù zhě yù shàn ér lí chǔ yù yuǎn ěr
  ]
]

