// Typst排版文件
// 宏导入：每行一个，行尾为速记说明；「//」注释不进成稿
// 歧义提示：「+」「-」在文档层是列表、枚举标记，只有在题目宏的内容块内才是对错记号；「*词*」是汉字下加点（着重号），不是加粗
#import "lib/book-setup.typ": (
  bz, // 备注：写给作者和编辑的要求和说明，成稿不保留
  setup-book, // 全书版式设置（开本、字号、行距）
  exercise-debug, // 调试开关：打开后原本透明的答案色变为深红
  ntp, // 注释、译文、拼音就近集成的版式
  snt, // 集成版式中的一句：#snt(notes: (…))[古文][译文][拼音]
  nt, // 行上注·不分类
  ntc, // 行上注·难解词语（文言独有词、古今异义等）
  ntj, // 行上注·难解句子（需整块理解）
  ntw, // 行上注·文化常识（人名、地名、年号、官职等）
  notes, // 一般随文注释
  kai, // 楷体字体切换（可以针对字符串或段落）
  tzg, // 田字格抄写：#tzg[字词][拼|音|分|格||]，`|`确定格子数量
  lxt, // 连线题：每行「+ 左栏 | 右栏」，竖线分左右，右栏自动乱序
  xzt, // 选择题：块内「-」干扰项、「+」正确项（可多个，自动生成“多选题”字样）
  pdt, // 判断对错：块内「+」对、「-」错
  pxt, // 排序题：「+」只表示列项，书写顺序即答案
  hct, // 划掉错误项：#hct[词][+ 正确项 | - 错误项]
  gzt, // 勾选正确项：#gzt[词][+ 正确项 | - 错误项]
  hxt, // 文中画线：#hxt[词]，在词语下画答案标记线
  py, // 行内字上注音
)
// #v(1em) 系统宏：垂直空白，版式占位（无需导入）
// #pagebreak() 系统宏：手动分页（无需导入）

// 设置
// 三段：字号下限16、14、12，注释下限10.5；行空下限5mm/0.89em、4mm/1.01em、3mm/0.71em
// 如果出现译文混乱的情况，可尝试微调宽度
#show: setup-book.with(width: 210mm, size: 14pt, leading: 4mm)
#exercise-debug()
// #exercise-debug(false)


//
// 以下是选文
//
= 孟母三迁
/*
邹孟轲之母也，号孟母。其舍近墓，孟子之少也，嬉游为墓间之事，踊跃筑埋。孟母曰：「此非吾所以居处子。」乃去，舍市傍。其嬉戏为贾人炫卖之事。孟母又曰：「此非吾所以居处子也。」复徙，舍学宫之傍。其嬉游乃设俎豆，揖让进退。孟母曰：「真可以居吾子矣。」遂居之（原文无“之”字）。
*/
#ntp[
  #snt(notes: (
    [孟子之名],
    [孟子之母，仉氏，以教子有方著称],
  ))[
    邹#ntc(ln: 1)[孟轲]之母也，号#ntc(ln: 1)[孟母]。
  ][
    孟子的母亲，姓仉，被称为孟母。
  ][
    zōu mèng kē zhī mǔ yě hào mèng mǔ
  ]
  #snt(notes: (
    [即孟轲，战国儒家代表人物],
    [欢欣奋起的样子],
    [堆土掩埋，指模仿丧葬游戏],
  ))[
    其舍近墓，#ntc(ln: 1)[孟子]之少也，嬉游为墓间之事，#ntc(ln: 1, a: "c")[踊跃]筑#ntc(ln: 1)[埋]。
  ][
    她家原先住在墓地附近，孟子年幼时，常在墓地间玩耍，欢喜雀跃地模仿堆土掩埋的丧葬游戏。
  ][
    qí shě jìn mù mèng zi zhī shǎo yě xī yóu wèi mù jiān zhī shì yǒng yuè zhù mái
  ]
  #snt(notes: (
    [用来……的方式],
  ))[
    孟母曰：“此非吾#ntc(ln: 1)[所以]居处子。”
  ][
    孟母说：“这里不是我该让儿子居住的地方。”
  ][
    mèng mǔ yuē cǐ fēi wú suǒ yǐ jū chǔ zi
  ]
  #snt(notes: (
    [集市],
  ))[
    乃去，舍#ntc[市]傍。
  ][
    于是便搬走，住到了集市旁边。
  ][
    nǎi qù shě shì bàng
  ]
  #snt(notes: (
    [商人，坐商],
    [夸耀叫卖],
  ))[
    其嬉戏为#ntc(ln: 1)[贾人]#ntc(ln: 1)[炫卖]之事。
  ][
    孟子玩耍时又学着商人夸耀叫卖的样子。
  ][
    qí xī xì wèi gǔ rén xuàn mài zhī shì
  ]
  #snt(notes: ())[
    孟母又曰：“此非吾所以居处子也。”
  ][
    孟母又说：“这里也不是我该让儿子居住的地方。”
  ][
    mèng mǔ yòu yuē cǐ fēi wú suǒ yǐ jū chǔ zi yě
  ]
  #snt(notes: (
    [迁移],
    [古代学校，此处指官办教学场所],
  ))[
    复#ntc[徙]，舍#ntc(ln: 1)[学宫]之傍。
  ][
    便再次搬迁，住到了官办学校的旁边。
  ][
    fù xǐ shě xué gōng zhī bàng
  ]
  #snt(notes: (
    [祭祀礼器],
    [作揖行礼],
    [前行与后退],
  ))[
    其嬉游乃设#ntc(ln: 1)[俎豆]，#ntc(ln: 1)[揖让]#ntc(ln: 1)[进退]。
  ][
    孟子玩耍时便摆设祭器，作揖行礼，进退有节。
  ][
    qí xī yóu nǎi shè zǔ dòu yī ràng jìn tuì
  ]
  #snt(notes: ())[
    孟母曰：“真可以居吾子矣。”
  ][
    孟母说：“这里才真正适合让我的儿子居住啊。”
  ][
    mèng mǔ yuē zhēn kě yǐ jū wú zǐ yǐ
  ]
  #snt(notes: ())[
    遂居之。
  ][
    于是就定居下来。
  ][
    suì jū zhī yuán wén wú zhī zì
  ]
]
