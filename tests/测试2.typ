// Typst排版文件
// 宏导入：每行一个，行尾为速记说明；「//」注释不进成稿
// 歧义提示：「+」「-」在文档层是列表、枚举标记，只有在题目宏的内容块内才是对错记号；「*词*」是汉字下加点（着重号），不是加粗
#import "lib/book-setup.typ": (
  bz, // 备注：写给作者和编辑的要求和说明，成稿不保留
  setup-book, // 全书版式设置（开本、字号、行距）
  exercise-debug, // 调试开关：打开后原本透明的答案色变为深红
  ntp, // 注释、译文、拼音就近集成的版式
  snt, // 集成版式中的一句：#snt(notes: (…))[古文][译文][拼音]
  nt, // 行上注·不分类
  ntc, // 行上注·难解词语（文言独有词、古今异义等）
  ntj, // 行上注·难解句子（需整块理解）
  ntw, // 行上注·文化常识（人名、地名、年号、官职等）
  notes, // 一般随文注释
  kai, // 楷体字体切换（可以针对字符串或段落）
  tzg, // 田字格抄写：#tzg[字词][拼|音|分|格||]，`|`确定格子数量
  lxt, // 连线题：每行「+ 左栏 | 右栏」，竖线分左右，右栏自动乱序
  xzt, // 选择题：块内「-」干扰项、「+」正确项（可多个，自动生成“多选题”字样）
  pdt, // 判断对错：块内「+」对、「-」错
  pxt, // 排序题：「+」只表示列项，书写顺序即答案
  hct, // 划掉错误项：#hct[词][+ 正确项 | - 错误项]
  gzt, // 勾选正确项：#gzt[词][+ 正确项 | - 错误项]
  hxt, // 文中画线：#hxt[词]，在词语下画答案标记线
  py, // 行内字上注音
)
// #v(1em) 系统宏：垂直空白，版式占位（无需导入）
// #pagebreak() 系统宏：手动分页（无需导入）

// 设置
// 三段：字号下限16、14、12，注释下限10.5；行空下限5mm/0.89em、4mm/1.01em、3mm/0.71em
// 如果出现译文混乱的情况，可尝试微调宽度
#show: setup-book.with(width: 210mm, size: 12pt, leading: 3mm)
#exercise-debug()
// #exercise-debug(false)


